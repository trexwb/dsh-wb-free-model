{
  "name": "dsh-wb-free-model",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "WB Free Model — 在 DSH 里装上这个插件，无需登录、注册或填 API Key，即可使用两条免密免费车道（OpenCode 免密池与 Kilo 公共池）；插件进程内直连，无运行时无子进程，iOS 宿主同样可用；WB · auto 自动挑选当前可用的最快免费模型。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trexwb/dsh-wb-free-model.git"
  },
  "homepage": "https://github.com/trexwb/dsh-wb-free-model",
  "bugs": {
    "url": "https://github.com/trexwb/dsh-wb-free-model/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "catalog",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "free-model",
    "llm-provider",
    "opencode"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1 || ^0.1.2-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
